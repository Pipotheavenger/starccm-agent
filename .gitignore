*.dmprj

# cfturbo/ se fue a su repositorio (cfturbo-agent); restos locales que aún no se pudieron borrar
cfturbo/

# lote/: estado de la corrida (no es código)
starccm/lote/estado.json
starccm/lote/propuestas.json
starccm/lote/PARAR
starccm/lote/.monitor_visto
starccm/lote/.lock
starccm/lote/*.tmp

# DOE distribuido (doe/, pat/): estado de la corrida y datos traídos de los workers (no es código)
starccm/doe/_traido/
starccm/doe/_stage/
starccm/doe/estado.json
starccm/doe/*.tmp
starccm/pat/**/_traido/
starccm/pat/**/_stage/
starccm/pat/**/estado.json
starccm/pat/**/*.tmp
starccm/doe/rango.json
starccm/pat/transitorio/_traido/
